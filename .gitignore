# =====================================
# PYTHON
# =====================================

__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual environments
.venv/
venv/
.env


# =====================================
# JUPYTER
# =====================================

.ipynb_checkpoints/


# =====================================
# OS
# =====================================

.DS_Store


# =====================================
# DATA STRATEGY - SINTELO CORE
# =====================================

# Raw ERP extracts — NEVER version
data/raw/

# Temporary / intermediate working files
data/temp/
data/intermediate/

# Local notebook artifacts
notebooks/data/


# =====================================
# OUTPUTS STRATEGY
# =====================================

# Default: ignore outputs
outputs/*

# Allow institutional baseline outputs only if explicitly committed
!outputs/.gitkeep
!outputs/context_*.json


# =====================================
# REPORTS STRATEGY
# =====================================

# Reports are institutional deliverables → versioned
# DO NOT IGNORE:
# notebooks/reports/


# =====================================
# BACKUPS
# =====================================

*.bak


# =====================================
# FUTURE ARCHITECTURE
# =====================================

# When src/ starts generating artifacts
src/**/__pycache__/
